// The station this build connects to. Copy to StationConfig.h and fill it in from
// the report of semaphore-install. StationConfig.h is not committed: it holds one
// machine's address.
//
// How a release build learns its station is not decided yet: see
// docs/10-clients/modifications.md in the main repository.
#ifndef STATIONCONFIG_H
#define STATIONCONFIG_H

#define STATION_HOST "192.0.2.1"
#define STATION_PORT 443
#define STATION_DC 1
#define STATION_RSA_KEY "-----BEGIN RSA PUBLIC KEY-----\n" \
                        "...\n" \
                        "-----END RSA PUBLIC KEY-----"
#define STATION_RSA_FINGERPRINT 0x0000000000000000ULL

#endif
